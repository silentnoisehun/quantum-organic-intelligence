venv/

# Measurement outputs (regenerated by the scripts, deterministic seeds)
quantum-loop-results.json
gpe-fft-fix-measurement.json

# Raw quantum hardware measurements — version controlled on purpose.
# Every number quoted in docs/ has to be traceable to the measurement file
# it came from, so the raw runs are part of the repository. The helper
# formats below stay out.
*.qasm
*.qpy
counts*.json
*_counts.json
shots*.json

